generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ChartData {
  symbol    String   @id @db.VarChar(32)
  provider  String   @default("twelve-data") @db.VarChar(32)
  payload   Json
  fetchedAt DateTime @map("fetched_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([fetchedAt])
  @@map("chart_data")
}
